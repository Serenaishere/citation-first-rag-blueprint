{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/citation-first-rag-evaluation-case.json",
  "title": "Citation-first RAG evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "question", "scope", "expected", "tags"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_document_ids"],
      "properties": {
        "allowed_document_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answerable", "evidence_document_ids"],
      "properties": {
        "answerable": { "type": "boolean" },
        "evidence_document_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "expected": {
            "properties": { "answerable": { "const": true } },
            "required": ["answerable"]
          }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "properties": { "evidence_document_ids": { "minItems": 1 } }
          }
        }
      },
      "else": {
        "properties": {
          "expected": {
            "properties": { "evidence_document_ids": { "maxItems": 0 } }
          }
        }
      }
    }
  ]
}
